        <!-- Faq start here -->
        <section id="ub-faq" class="ub-faq" data-aos="fade-up" data-aos-delay="100">
            <div class="ub-faq__container container">
                <div class="ub-faq__grid" data-aos="fade-up" data-aos-delay="200">
                    <!-- Section Heading -->
                    <div class="ub-faq__heading" data-aos="fade-up" data-aos-delay="300">
                        <div class="ub-faq__subtitle-area" data-aos="fade-up" data-aos-delay="400">
                            <div class="ub-faq__subtitle-group">
                                <i data-lucide="badge-question-mark" class="my-class"></i>
                                <span class="ub-faq__subtitle">Sık Sorulan Sorular</span>
                            </div>
                        </div>
                        <h2 class="ub-faq__title" data-aos="fade-up" data-aos-delay="500">Merak Ettikleriniz</h2>
                    </div>
                    <!-- FAQ Area -->
                    <div class="ub-faq__list" data-aos="fade-up" data-aos-delay="600">
                        <!-- FAQ Item -->
                        <div class="ub-faq__item active" data-aos="fade-up" data-aos-delay="700">
                            <button class="ub-faq__question active">
                                <span class="ub-faq__question-text">Bri.com.tr nasıl çalışır?</span>
                            </button>
                            <div class="ub-faq__answer active">
                                <p>Stok tutmadan satış yapmanızı sağlayan dropshipping modeliyle çalışıyoruz. Ürünleri biz depolarız, siz satarsınız.</p>
                            </div>
                        </div>
                        <div class="ub-faq__item" data-aos="fade-up" data-aos-delay="800">
                            <button class="ub-faq__question">
                                <span class="ub-faq__question-text">XML entegrasyonu nedir?</span>
                            </button>
                            <div class="ub-faq__answer">
                                <p>Binlerce ürünü otomatik olarak sitenize aktarmanızı sağlayan sistemdir. Fiyat ve stok güncellemeleri anlık yapılır.</p>
                            </div>
                        </div>
                        <div class="ub-faq__item" data-aos="fade-up" data-aos-delay="900">
                            <button class="ub-faq__question">
                                <span class="ub-faq__question-text">Kargo işlemleri nasıl yapılıyor?</span>
                            </button>
                            <div class="ub-faq__answer">
                                <p>Tüm kargo işlemlerini biz hallederiz. Siparişler otomatik olarak kargoya verilir ve müşterinize ulaştırılır.</p>
                            </div>
                        </div>
                        <div class="ub-faq__item" data-aos="fade-up" data-aos-delay="1000">
                            <button class="ub-faq__question">
                                <span class="ub-faq__question-text">Hangi platformlarla entegrasyon sağlıyorsunuz?</span>
                            </button>
                            <div class="ub-faq__answer">
                                <p>Trendyol, Hepsiburada, N11, Çiçeksepeti ve daha birçok popüler e-ticaret platformu ile entegrasyon sağlıyoruz.</p>
                            </div>
                        </div>
                        <div class="ub-faq__item" data-aos="fade-up" data-aos-delay="1200">
                            <button class="ub-faq__question">
                                <span class="ub-faq__question-text">Destek hizmeti nasıl?</span>
                            </button>
                            <div class="ub-faq__answer">
                                <p>7/24 canlı destek hizmeti sunuyoruz. Telefon, e-posta ve canlı chat ile her zaman ulaşabilirsiniz.</p>
                            </div>
                        </div>
                        <div class="ub-faq__item" data-aos="fade-up" data-aos-delay="1300">
                            <button class="ub-faq__question">
                                <span class="ub-faq__question-text">Ödeme nasıl yapılıyor?</span>
                            </button>
                            <div class="ub-faq__answer">
                                <p>Kredi kartı, havale/EFT ve diğer güvenli ödeme yöntemleriyle kolayca ödeme yapabilirsiniz.</p>
                            </div>
                        </div>
                    </div> 
                </div>
            </div>
        </section>
        <!-- Faq end here -->

