<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>bri.com.tr - Stok yok, Risk yok, Kazanç çok.</title>
  
    <!-- main css -->
    <link rel="stylesheet" href="./css/main.css">
    <link rel="icon" type="image/png" href="./assets/img/fav/fav.jpg">

    <!-- font awesome css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" >

    <!-- AOS animation  css-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">

    <!-- swiper css -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" >
    
    <!-- SweetAlert2 css -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <link rel="stylesheet" href="https://unpkg.com/lucide@latest/dist/umd/lucide.js">
   
    <!-- Development version -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <!-- Production version -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Temporary overrides for new mobile menu look (can be merged into main.css after SCSS compile) -->
    <link rel="stylesheet" href="./css/_overrides-mobile-menu.css">
    
    <style>
    .my-class {
    color: #193470;
    }

    /* Sliding Cards Section */
    .ub-sliding-cards {
        padding: 80px 0;
        background: #f8fafc;
        overflow: hidden;
    }

    .ub-sliding-cards__container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .ub-sliding-cards__header {
        text-align: center;
        margin-bottom: 60px;
    }

    .ub-sliding-cards__subtitle-area {
        margin-bottom: 20px;
    }

    .ub-sliding-cards__subtitle-group {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(25, 52, 112, 0.1);
        padding: 8px 16px;
        border-radius: 20px;
        color: #193470;
        font-size: 14px;
        font-weight: 500;
    }

    .ub-sliding-cards__title {
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 16px;
        line-height: 1.2;
    }

    .ub-sliding-cards__desc {
        font-size: 18px;
        color: #64748b;
        line-height: 1.6;
        max-width: 600px;
        margin: 0 auto;
    }

    .ub-sliding-cards__wrapper {
        overflow: hidden;
        position: relative;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 0;
        cursor: grab;
        user-select: none;
    }

    .ub-sliding-cards__wrapper:active {
        cursor: grabbing;
    }

    .ub-sliding-cards__wrapper.dragging {
        cursor: grabbing;
    }

    .ub-sliding-cards__track {
        display: flex;
        gap: 25px;
        transition: transform 0.3s ease-out;
        will-change: transform;
    }

    .ub-sliding-cards__track.dragging {
        transition: none;
    }

    .ub-sliding-cards__card {
        flex: 0 0 320px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: all 0.3s ease;
        cursor: pointer;
        min-width: 320px;
        max-width: 320px;
        pointer-events: none;
    }

    .ub-sliding-cards__card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .ub-sliding-cards__image {
        width: 100%;
        height: 200px;
        overflow: hidden;
        background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
        position: relative;
    }

    .ub-sliding-cards__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.3s ease;
        pointer-events: none;
        user-select: none;
    }

    .ub-sliding-cards__card:hover .ub-sliding-cards__image img {
        transform: scale(1.05);
    }

    .ub-sliding-cards__content {
        padding: 25px 20px;
    }

    .ub-sliding-cards__card-title {
        font-size: 18px;
        font-weight: 600;
        color: #1a202c;
        margin-bottom: 10px;
        line-height: 1.3;
        pointer-events: none;
        user-select: none;
    }

    .ub-sliding-cards__card-desc {
        font-size: 14px;
        color: #64748b;
        line-height: 1.5;
        pointer-events: none;
        user-select: none;
    }

    /* Desktop - 3 cards with half cards on sides */
    @media (min-width: 1025px) {
        .ub-sliding-cards__wrapper {
            max-width: 1040px;
            padding-left: 160px;
            padding-right: 160px;
        }
        
        .ub-sliding-cards__track {
            gap: 30px;
        }
        
        .ub-sliding-cards__card {
            flex: 0 0 320px;
        }
    }

    /* Tablet responsive */
    @media (min-width: 769px) and (max-width: 1024px) {
        .ub-sliding-cards__wrapper {
            max-width: 800px;
            padding-left: 120px;
            padding-right: 120px;
        }
        
        .ub-sliding-cards__card {
            flex: 0 0 280px;
            min-width: 280px;
            max-width: 280px;
        }
        
        .ub-sliding-cards__track {
            gap: 25px;
        }
    }

    /* Mobile responsive */
    @media (max-width: 768px) {
        .ub-sliding-cards {
            padding: 60px 0;
        }
        
        .ub-sliding-cards__container {
            padding: 0 15px;
        }
        
        .ub-sliding-cards__header {
            margin-bottom: 40px;
        }
        
        .ub-sliding-cards__wrapper {
            max-width: 100%;
            padding-left: 60px;
            padding-right: 60px;
        }
        
        .ub-sliding-cards__track {
            gap: 20px;
        }
        
        .ub-sliding-cards__card {
            flex: 0 0 250px;
            min-width: 250px;
            max-width: 250px;
        }
        
        .ub-sliding-cards__image {
            height: 150px;
        }
        
        .ub-sliding-cards__content {
            padding: 20px 15px;
        }
        
        .ub-sliding-cards__card-title {
            font-size: 16px;
        }
        
        .ub-sliding-cards__card-desc {
            font-size: 13px;
        }
    }

    @media (max-width: 480px) {
        .ub-sliding-cards__wrapper {
            padding-left: 40px;
            padding-right: 40px;
        }
        
        .ub-sliding-cards__card {
            flex: 0 0 220px;
            min-width: 220px;
            max-width: 220px;
        }
    }

    /* ===================================
       INTEGRATIONS SECTION - NEW LAYOUT
       =================================== */
    
    .ub-integrations__container {
        display: flex !important;
        align-items: center !important;
        gap: 60px !important;
    }

    /* Left Side - Text Content (50%) */
    .ub-integrations__header {
        flex: 0 0 48% !important;
        max-width: 48% !important;
        text-align: left !important;
    }

    .ub-integrations__subtitle-area {
        margin-bottom: 20px !important;
    }

    .ub-integrations__title {
        font-size: clamp(32px, 4vw, 56px) !important;
        font-weight: 900 !important;
        color: #ffffff !important;
        margin-bottom: 20px !important;
        letter-spacing: -0.03em !important;
        line-height: 1.1 !important;
    }

    .ub-integrations__desc {
        font-size: clamp(16px, 1.8vw, 20px) !important;
        color: rgba(255, 255, 255, 0.85) !important;
        margin-bottom: 0 !important;
        line-height: 1.6 !important;
    }

    .ub-integrations__subtitle-group {
        background: rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        padding: 10px 20px !important;
        border-radius: 25px !important;
        backdrop-filter: blur(10px) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
    }

    /* Right Side - Logos Container (50%) */
    .ub-integrations__logos {
        flex: 0 0 48% !important;
        max-width: 48% !important;
        background: rgba(255, 255, 255, 0.05) !important;
        border-radius: 32px !important;
        padding: 50px 30px !important;
        border: 2px solid rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(10px) !important;
        overflow: hidden !important;
        position: relative !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 25px !important;
    }

    /* Logo Rows Animation */
    .ub-integrations__slider-left,
    .ub-integrations__slider-right {
        overflow: hidden !important;
        position: relative !important;
    }

    .ub-integrations__slider-wrapper {
        display: flex !important;
        gap: 20px !important;
        animation-timing-function: linear !important;
        animation-iteration-count: infinite !important;
        will-change: transform !important;
    }

    /* Row 1 - Slide Left */
    .ub-integrations__slider-left .ub-integrations__slider-wrapper {
        animation: slideIntegrationsLeft 30s linear infinite !important;
    }

    /* Row 2 - Slide Right */
    .ub-integrations__slider-right .ub-integrations__slider-wrapper {
        animation: slideIntegrationsRight 30s linear infinite !important;
    }

    @keyframes slideIntegrationsLeft {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(calc(-50%));
        }
    }

    @keyframes slideIntegrationsRight {
        0% {
            transform: translateX(calc(-50%));
        }
        100% {
            transform: translateX(0);
        }
    }

    .ub-integrations__slider-item {
        flex-shrink: 0 !important;
        background: rgba(255, 255, 255, 0.08) !important;
        padding: 18px 28px !important;
        border-radius: 16px !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        transition: all 0.3s ease !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        min-width: 130px !important;
        height: 75px !important;
    }

    .ub-integrations__slider-item:hover {
        background: rgba(255, 255, 255, 0.12) !important;
        border-color: rgba(255, 255, 255, 0.2) !important;
        transform: translateY(-3px) !important;
    }

    .ub-integrations__logo {
        max-width: 100% !important;
        max-height: 40px !important;
        object-fit: contain !important;
        filter: brightness(0) invert(1) !important;
        opacity: 0.9 !important;
        transition: opacity 0.3s ease !important;
    }

    .ub-integrations__slider-item:hover .ub-integrations__logo {
        opacity: 1 !important;
    }

    /* Integrations Responsive */
    @media (max-width: 1024px) {
        .ub-integrations__container {
            flex-direction: column !important;
            gap: 50px !important;
        }
        
        .ub-integrations__header,
        .ub-integrations__logos {
            flex: 0 0 100% !important;
            max-width: 100% !important;
        }
        
        .ub-integrations__header {
            text-align: center !important;
        }
    }

    @media (max-width: 768px) {
        .ub-integrations__logos {
            padding: 35px 20px !important;
            border-radius: 24px !important;
            gap: 20px !important;
        }
        
        .ub-integrations__slider-item {
            min-width: 110px !important;
            height: 65px !important;
            padding: 15px 20px !important;
        }
        
        .ub-integrations__logo {
            max-height: 32px !important;
        }
    }
    </style>

</head>
