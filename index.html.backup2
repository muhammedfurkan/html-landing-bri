        <!-- How it works start here -->
        <section id="ub-how-it-works" class="ub-how-it-works" data-aos="fade-up" data-aos-delay="100"> 
            <div class="ub-how-it-works__container container">
                <div class="ub-how-it-works__content-area">
                    <div class="ub-how-it-works__header" data-aos="fade-up">
                        <div class="ub-how-it-works__subtitle-area" data-aos="fade-up" data-aos-delay="200">
                            <div class="ub-how-it-works__subtitle-group">
                                <i data-lucide="badge-check" class="my-class"></i>
                                <span class="ub-how-it-works__subtitle">İşinizi kolaylaştırır</span>
                            </div>
                        </div>
                        <h2 class="ub-how-it-works__title" data-aos="fade-up" data-aos-delay="300">Nasıl Çalışır</h2>
                        <p class="ub-how-it-works__desc" data-aos="fade-up" data-aos-delay="400">Stoksuz satış modeliyle işletmenizi büyütmek için gereken tüm araçları sunuyoruz.</p>
                    </div>
                    <div class="ub-how-it-works__content">
                        <div class="ub-how-it-works__step" data-aos="fade-up" data-aos-delay="500"> 
                            <div class="ub-how-it-works__step-icon">
                                <i data-lucide="user-plus" class="my-class"></i>
                            </div>
                            <h3 class="ub-how-it-works__step-title">Kayıt Olun</h3>
                            <p class="ub-how-it-works__step-description">Hızlıca hesap oluşturun ve sisteme entegre olun.</p>
                        </div>
                        <div class="ub-how-it-works__step" data-aos="fade-up" data-aos-delay="600">
                            <div class="ub-how-it-works__step-icon">
                                <i data-lucide="shopping-cart" class="my-class"></i>
                            </div>
                            <h3 class="ub-how-it-works__step-title">Ürünleri Ekleyin</h3>
                            <p class="ub-how-it-works__step-description">XML entegrasyonu ile binlerce ürünü sitenize aktarın.</p>
