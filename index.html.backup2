        <!-- footer end here --> 

 
    <!-- js  -->
    <!--  AOS JavaScript -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <!-- SweetAlert2 js  -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Swiper js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js" integrity="sha512-Ysw1DcK1P+uYLqprEAzNQJP+J4hTx4t/3X2nbVwszao8wD+9afLjBQYjz7Uk4ADP+Er++mJoScI42ueGtQOzEA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Main js -->
    <script src="./assets/js/srcipts.js"></script>
    <!-- Form js -->
    <script src="./assets/js/form.js"></script>   
    <!-- Blog Loader js -->
    <script src="./assets/js/blog-loader.js"></script>
    <!-- Pricing Loader js -->
    <!-- <script src="./assets/js/pricing-loader.js"></script> -->
    
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        lucide.createIcons();
        
        // Sliding cards with continuous drag functionality
        document.addEventListener('DOMContentLoaded', function() {
            const wrapper = document.querySelector('.ub-sliding-cards__wrapper');
            const track = document.querySelector('.ub-sliding-cards__track');
            
            if (!wrapper || !track) return;
            
            const originalCards = Array.from(track.children);
            const totalOriginalCards = originalCards.length;
            
            // Create many clones for smooth infinite scroll
            for (let i = 0; i < 20; i++) { // More clones for smoother infinite scroll
                originalCards.forEach(card => {
                    const clone = card.cloneNode(true);
                    track.appendChild(clone);
                });
            }
            
            let isDragging = false;
            let startX = 0;
            let currentTranslate = 0;
            let animationFrame = 0;
            let velocity = 0;
            let lastTime = 0;
            let lastX = 0;
            
            // Calculate card dimensions
            function getCardDimensions() {
                const cardWidth = originalCards[0].offsetWidth;
                const gap = window.innerWidth >= 1025 ? 30 : (window.innerWidth >= 769 ? 25 : 20);
                return { cardWidth, gap, cardWithGap: cardWidth + gap };
            }
            
            let { cardWidth, gap, cardWithGap } = getCardDimensions();
            const oneSetWidth = cardWithGap * totalOriginalCards;
            
            // Start from the middle
            currentTranslate = -oneSetWidth * 10; // Start from middle of clones
            track.style.transform = `translateX(${currentTranslate}px)`;
            
            function checkInfiniteLoop() {
                // Smooth infinite loop - when reaching boundaries, smoothly reset position
                if (currentTranslate > -oneSetWidth * 5) {
                    // Moving too far right, smoothly reset to middle-left
                    currentTranslate -= oneSetWidth * 10;
                    track.style.transition = 'none';
                    track.style.transform = `translateX(${currentTranslate}px)`;
                    requestAnimationFrame(() => {
                        track.style.transition = '';
                    });
                } else if (currentTranslate < -oneSetWidth * 15) {
                    // Moving too far left, smoothly reset to middle-right
                    currentTranslate += oneSetWidth * 10;
                    track.style.transition = 'none';
                    track.style.transform = `translateX(${currentTranslate}px)`;
                    requestAnimationFrame(() => {
                        track.style.transition = '';
                    });
                }
            }
            
            function updatePosition() {
                if (!isDragging && Math.abs(velocity) > 0.1) {
                    // Apply momentum when not dragging
                    currentTranslate += velocity;
                    velocity *= 0.95; // Friction
                    checkInfiniteLoop();
                    track.style.transform = `translateX(${currentTranslate}px)`;
                    requestAnimationFrame(updatePosition);
                }
            }
            
            // Mouse events
            wrapper.addEventListener('mousedown', startDrag);
            document.addEventListener('mousemove', drag);
            document.addEventListener('mouseup', endDrag);
            
            // Touch events
            wrapper.addEventListener('touchstart', startDrag, { passive: false });
            document.addEventListener('touchmove', drag, { passive: false });
            document.addEventListener('touchend', endDrag);
            
            function startDrag(e) {
                isDragging = true;
                wrapper.classList.add('dragging');
                track.classList.add('dragging');
                track.style.transition = 'none';
                
                const clientX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                startX = clientX;
                lastX = clientX;
                lastTime = Date.now();
                velocity = 0;
                
                cancelAnimationFrame(animationFrame);
                e.preventDefault();
            }
            
            function drag(e) {
                if (!isDragging) return;
                e.preventDefault();
                
                const clientX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                const deltaX = clientX - lastX;
                const currentTime = Date.now();
                const deltaTime = currentTime - lastTime;
                
                // Calculate velocity for momentum
                if (deltaTime > 0) {
                    velocity = deltaX / deltaTime * 16; // 60fps adjustment
                }
                
                currentTranslate += deltaX;
                lastX = clientX;
                lastTime = currentTime;
                
                checkInfiniteLoop();
                
                animationFrame = requestAnimationFrame(() => {
                    track.style.transform = `translateX(${currentTranslate}px)`;
                });
            }
            
            function endDrag(e) {
                if (!isDragging) return;
                
                isDragging = false;
                wrapper.classList.remove('dragging');
                track.classList.remove('dragging');
                
                cancelAnimationFrame(animationFrame);
                
                // Start momentum scrolling
                updatePosition();
            }
            
            // Prevent default behaviors
            track.addEventListener('dragstart', e => e.preventDefault());
            wrapper.addEventListener('selectstart', e => e.preventDefault());
            
            // Only horizontal scroll support (no vertical)
            wrapper.addEventListener('wheel', (e) => {
                // Only handle horizontal scroll (deltaX)
                const deltaX = e.deltaX;
                
                if (Math.abs(deltaX) > 0) {
                    e.preventDefault();
                    currentTranslate -= deltaX * 2; // Horizontal scroll sensitivity
                    checkInfiniteLoop();
                    track.style.transform = `translateX(${currentTranslate}px)`;
                }
            }, { passive: false });
            
            // Touchpad gesture support for horizontal swipe only
            let touchStartX = 0;
            let isHorizontalGesture = false;
            
            wrapper.addEventListener('touchstart', (e) => {
                if (e.touches.length === 2) {
                    touchStartX = e.touches[0].clientX;
                    isHorizontalGesture = false;
                }
            }, { passive: false });
            
            wrapper.addEventListener('touchmove', (e) => {
                if (e.touches.length === 2 && !isDragging) {
                    const touchCurrentX = e.touches[0].clientX;
                    const deltaX = touchCurrentX - touchStartX;
                    
                    // Only handle horizontal gestures
                    if (Math.abs(deltaX) > 10) {
                        e.preventDefault();
                        isHorizontalGesture = true;
                        currentTranslate += deltaX * 2;
                        checkInfiniteLoop();
                        track.style.transform = `translateX(${currentTranslate}px)`;
                        touchStartX = touchCurrentX;
                    }
                }
            }, { passive: false });
            
            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    currentTranslate += cardWithGap;
                    checkInfiniteLoop();
                    track.style.transition = 'transform 0.3s ease-out';
                    track.style.transform = `translateX(${currentTranslate}px)`;
                    setTimeout(() => {
                        track.style.transition = 'none';
                    }, 300);
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    currentTranslate -= cardWithGap;
                    checkInfiniteLoop();
                    track.style.transition = 'transform 0.3s ease-out';
                    track.style.transform = `translateX(${currentTranslate}px)`;
                    setTimeout(() => {
                        track.style.transition = 'none';
                    }, 300);
                }
            });
            
            // Handle window resize
            window.addEventListener('resize', () => {
                const newDimensions = getCardDimensions();
                const oldOneSetWidth = oneSetWidth;
                cardWidth = newDimensions.cardWidth;
                gap = newDimensions.gap;
                cardWithGap = newDimensions.cardWithGap;
                
                // Maintain relative position during resize
                const relativePosition = currentTranslate / oldOneSetWidth;
                const newOneSetWidth = cardWithGap * totalOriginalCards;
                currentTranslate = relativePosition * newOneSetWidth;
                track.style.transform = `translateX(${currentTranslate}px)`;
            });
        });
    </script>

</body>
</html>
