    <main>
        <!-- Hero start here -->
        <section id="ub-hero-home" class="ub-hero-home">
            <div class="ub-hero-home__container container">
                <div class="ub-hero-home__content-area" data-aos="fade-up" data-aos-delay="100">
                    <div class="ub-hero-home__content" data-bg-img="./assets/img/hero/heroBg.png">
                        <div class="ub-hero-home__subtitle-area">
                            <div class="ub-hero-home__subtitle-group" data-aos="fade-up" data-aos-delay="200">
                                <i data-lucide="star" class="my-class"></i>
                                <span class="ub-hero-home__subtitle">Stoksuz Satışta Yeni Bir Dönem</span>
                            </div>
                        </div>
                        <h1 class="ub-hero-home__title" data-aos="fade-up" data-aos-delay="300" style="color: white;">
                        Stok Tutmadan Satış Yapın, İşinizi Büyütün
                        </h1>
                        <p class="ub-hero-home__desc" data-aos="fade-up" data-aos-delay="400" style="color: lightgrey;">Bri.com.tr ile dropshipping, XML entegrasyonu ve lojistik desteği alarak e-ticaret operasyonlarınızı kolaylaştırın.</p>
                        <div class="ub-hero-home__button-group">
                            <a href="https://briportal.com/register" class="ub-hero-home__button ub-hero-home__button--primary" data-aos="fade-up" data-aos-delay="500">Üye Ol</a>
                            <a href="#ub-how-it-works" class="ub-hero-home__button ub-hero-home__button--secondary" data-aos="fade-up" data-aos-delay="600">Keşfet</a>
                        </div>
                    </div> 
                </div>
                <!-- Background Image -->
                <div class="ub-hero-home__image-wrapper" data-aos="fade-up" data-aos-delay="700">
                    <img class="ub-hero-home__img" src="./assets/img/hero/application-shell.png" alt="Application Shell">
                </div>
            </div>
        </section>        
        <!-- Hero end here -->

        <!-- Brands section start -->
